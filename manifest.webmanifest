{
  "id": "./",
  "name": "A Miña Horta",
  "short_name": "A Miña Horta",
  "description": "Tu huerta, tu diario y tu venta en una sola app. Sin cuenta: tus datos se quedan en tu aparato.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#EEF5EA",
  "theme_color": "#EEF5EA",
  "categories": [
    "lifestyle",
    "productivity"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "./compartir-foto",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "fotos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "iconos/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "iconos/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "iconos/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "iconos/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "iconos/icon-notificacion-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "iconos/icon-notificacion-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "screenshots": [
    {
      "src": "capturas/movil-hoxe.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "«Hoy»: lo de hoy en tu huerta"
    },
    {
      "src": "capturas/movil-mapa.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "El mapa de tus jardineras"
    },
    {
      "src": "capturas/tableta-hoxe.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "En la tableta: «Hoy» a dos columnas"
    }
  ],
  "shortcuts": [
    {
      "name": "Apuntar cosecha",
      "short_name": "Cosecha",
      "description": "Apunta lo que has cosechado.",
      "url": "./#atajo-cosechar",
      "icons": [
        {
          "src": "iconos/icon-atajo-cosechar.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Vender",
      "short_name": "Vender",
      "description": "Cobra una venta.",
      "url": "./#atajo-vender",
      "icons": [
        {
          "src": "iconos/icon-atajo-vender.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Regué hoy",
      "short_name": "Regué",
      "description": "Apunta el riego de hoy.",
      "url": "./#atajo-regue",
      "icons": [
        {
          "src": "iconos/icon-atajo-regue.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Esta semana",
      "short_name": "Esta semana",
      "description": "Lo que toca estos días",
      "url": "./#atajo-semana",
      "icons": [
        {
          "src": "iconos/icon-atajo-semana.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
